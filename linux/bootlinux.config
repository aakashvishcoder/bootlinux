# Kernel config fragment, applied on top of `make tinyconfig`.
# Goal: the smallest RV32 kernel that boots to a shell on the emulator.

# --- CPU: RV32IMA only, so the emulator needs no C/F/D/V extensions
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_32BIT=y
CONFIG_MMU=y
# CONFIG_SMP is not set
# The EFI stub forces RISCV_ISA_C on, so EFI goes too.
# CONFIG_RISCV_ISA_C is not set
# CONFIG_EFI is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZFA is not set
CONFIG_RISCV_SBI=y
CONFIG_CMDLINE=""

# --- Interrupts and timer: PLIC for the UART, SBI timer
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y

# --- Console: 16550 UART from the device tree, SBI early console
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_OF=y

# --- User space: ELF binaries from an initramfs built into the kernel
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="initramfs.list"
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_ELF_CORE=n

# --- Small but informative
CONFIG_KALLSYMS=y
CONFIG_BUG=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
